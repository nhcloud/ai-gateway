<!--
  The same Azure OpenAI API policy, plus the gateway-side Content Safety guardrail.

  Applied by:  .\02-configure-apim.ps1 -EnableContentSafetyPolicy

  The demo app screens prompts itself so the per-category severities can be shown in
  the UI. This policy does the same job with no client code at all - which is the
  version you want in production, because it cannot be bypassed by a client that
  forgets to call it. Running both means paying for two checks, so pick one.

  Named values (created by 02-configure-apim.ps1):
    {{aoai-key}}
  Backend entity:
    content-safety-backend  - points at the Content Safety resource, with its key
-->
<policies>
  <inbound>
    <base />

    <cors allow-credentials="false">
      <allowed-origins>
        <origin>*</origin>
      </allowed-origins>
      <allowed-methods preflight-result-max-age="300">
        <method>OPTIONS</method>
        <method>GET</method>
        <method>POST</method>
      </allowed-methods>
      <allowed-headers>
        <header>api-key</header>
        <header>Authorization</header>
        <header>Content-Type</header>
        <header>x-correlation-id</header>
      </allowed-headers>
      <expose-headers>
        <header>x-ratelimit-remaining-tokens</header>
        <header>x-ratelimit-consumed-tokens</header>
        <header>x-correlation-id</header>
      </expose-headers>
    </cors>

    <set-header name="api-key" exists-action="override">
      <value>{{aoai-key}}</value>
    </set-header>

    <set-variable name="correlationId"
                  value='@(context.Request.Headers.GetValueOrDefault("x-correlation-id", context.RequestId.ToString()))' />

    <!-- Moderates the prompt before the model is called. A blocked request returns
         403 and costs nothing at the provider.
         shield-prompt also screens for jailbreak / indirect prompt injection. -->
    <llm-content-safety backend-id="content-safety-backend" shield-prompt="true">
      <categories output-type="FourSeverityLevels">
        <category name="Hate" threshold="4" />
        <category name="SelfHarm" threshold="4" />
        <category name="Sexual" threshold="4" />
        <category name="Violence" threshold="4" />
      </categories>
    </llm-content-safety>

    <llm-token-limit counter-key="@(context.Subscription?.Id ?? context.Request.IpAddress)"
                     tokens-per-minute="10000"
                     estimate-prompt-tokens="true"
                     retry-after-header-name="Retry-After"
                     remaining-tokens-header-name="x-ratelimit-remaining-tokens"
                     tokens-consumed-header-name="x-ratelimit-consumed-tokens" />

    <llm-emit-token-metric namespace="ai-gateway-demo">
      <dimension name="Subscription" value='@(context.Subscription?.Name ?? "anonymous")' />
      <dimension name="API" value="@(context.Api.Name)" />
      <dimension name="CorrelationId" value='@((string)context.Variables["correlationId"])' />
    </llm-emit-token-metric>
  </inbound>

  <backend>
    <base />
  </backend>

  <outbound>
    <base />
    <set-header name="x-correlation-id" exists-action="override">
      <value>@((string)context.Variables["correlationId"])</value>
    </set-header>
    <set-header name="x-gateway" exists-action="override">
      <value>@(context.Deployment.ServiceName)</value>
    </set-header>
  </outbound>

  <on-error>
    <base />
    <set-header name="x-correlation-id" exists-action="override">
      <value>@((string)context.Variables.GetValueOrDefault("correlationId", "none"))</value>
    </set-header>
  </on-error>
</policies>
