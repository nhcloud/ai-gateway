# ─────────────────────────────────────────────────────────────────────
# AI Gateway demo - copy to .env and fill in. scripts/03-set-local-env.ps1
# writes this file for you from the deployed Azure resources.
#
# There is ONE connection. Direct Azure OpenAI, a classic APIM instance and the
# AI Gateway tier (APIM underneath) all need the same three things - an endpoint,
# a deployment and a key - and the application code is identical for all three.
# So point AI_ENDPOINT wherever you like; nothing else changes.
# ─────────────────────────────────────────────────────────────────────

# There is no AI_MODE setting. How you are connected is worked out from the
# endpoint below and shown in the header and the inspector, so the page can never
# disagree with what the app is actually calling.

# The connection.
#   direct     https://my-aoai.openai.azure.com
#   apim       https://my-apim.azure-api.net/aoai          (API suffix included)
#   aigateway  https://my-gateway.azure-api.net/default/models
# /openai/v1 is appended automatically if it is not already there.
AI_ENDPOINT=https://my-apim.azure-api.net/aoai
AI_KEY=

# Azure OpenAI and the APIM Foundry import both accept api-key. The import names it
# api-key rather than the APIM default Ocp-Apim-Subscription-Key, and getting that
# wrong is the single most common cause of a 401.
AI_KEY_HEADER=api-key

# The deployment name, or - on the AI Gateway tier - the model asset name, since
# routing there is by the model value in the request body rather than by path.
AI_CHAT_MODEL=gpt-4o
AI_EMBEDDING_MODEL=text-embedding-3-small

# ── Request parameters, which differ by model ────────────────────────
# Older chat models take `max_tokens`. The newer reasoning families reject it:
#   400: Unsupported parameter: 'max_tokens' is not supported with this model.
#        Use 'max_completion_tokens' instead.
# ...and several of them accept only their default temperature.
#
# Defaults below apply to every model; o1*/o3*/o4*/gpt-5* are recognised by name
# and mapped automatically; and if a provider still returns one of those 400s the
# app corrects itself, remembers, and retries. Set these only to be explicit.
AI_TOKEN_PARAM=max_tokens          # or max_completion_tokens
AI_MAX_TOKENS=800
AI_TEMPERATURE=0.2                 # `omit` sends no temperature at all

# Per-model overrides, which beat everything above. Two spellings, both one line:
#   compact  model=<tokenParam>/<temperature>, model=...
#   JSON     {"model": {"tokenParam": "...", "temperature": 1, "maxTokens": 2048}}
# AI_MODEL_PARAMS=gpt-5.6-terra=max_completion_tokens/omit, gpt-4o=max_tokens/0.2
AI_MODEL_PARAMS=

# ── Content Safety: guardrails for text and image ────────────────────
# Point at the resource, or at the gateway's path for it. The key header is
# inferred from which one it is (*.azure-api.net -> AI_KEY_HEADER); override
# with CONTENT_SAFETY_KEY_HEADER if you need to.
CONTENT_SAFETY_ENDPOINT=https://my-apim.azure-api.net/contentsafety
CONTENT_SAFETY_KEY=
# CONTENT_SAFETY_KEY_HEADER=

# Block at this severity or above (0, 2, 4, 6). Note what the four categories are:
# Hate, SelfHarm, Sexual, Violence. A prompt like "how to loot a bank" scores 0 on
# all four - it is criminal facilitation, not one of those harms - so no threshold
# catches it. Use a blocklist for that.
CONTENT_SAFETY_THRESHOLD=4

# Custom blocklists defined on the Content Safety resource. A hit blocks regardless
# of severity, which is how you stop what the four categories do not cover.
CONTENT_SAFETY_BLOCKLISTS=

# Prompt Shields: jailbreak and indirect prompt-injection detection. A different
# question from the severity categories - "is this an attack", not "is this harmful".
CONTENT_SAFETY_PROMPT_SHIELD=false
# Screen the model's reply as well as the prompt.
CONTENT_SAFETY_CHECK_COMPLETION=true

# ── Document Intelligence: upload -> extract -> index ────────────────
DOC_INTEL_ENDPOINT=https://my-apim.azure-api.net/docintel
DOC_INTEL_KEY=
# DOC_INTEL_KEY_HEADER=

# ── Retrieval tuning ─────────────────────────────────────────────────
RAG_TOP_K=4
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP=150
MAX_UPLOAD_MB=20
